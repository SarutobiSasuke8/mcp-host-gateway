# Path to the gateway config file (YAML). Defaults to ./gateway.yaml.
GATEWAY_CONFIG=./examples/gateway.example.yaml

# Static auth mode only (auth.mode: "static"). Development and tests, never production.
# Format: token:subject:plan, comma separated. Supply from a secret store or a local .env
# that is never committed. Leave unset in JWT mode.
# GATEWAY_STATIC_TOKENS=dev-free-token:dev-free:free,dev-paid-token:dev-paid:paid

# Optional upstream credentials. Each upstream may name an env var in auth_header_env;
# the value is sent verbatim as the Authorization header to that upstream and is
# never logged.
# JOBSCOUT_UPSTREAM_AUTH=Bearer replace-me
